meta {
  name: 409 SKU sudah ada
  type: http
  seq: 7
}

post {
  url: {{productUrl}}/api/products
  body: json
  auth: none
}

headers {
  API-Version: 1
}

body:json {
  { "sku": "KOPI-ARB-250", "name": "Kopi Arabika Gayo", "price": 85000 }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("application/problem+json dengan status = status HTTP", function() {
    expect(res.headers['content-type']).to.contain('application/problem+json');
    expect(res.body.status).to.equal(res.status);
  });
}
