          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, service_name, method, uri) (rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\",uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{service_name}} {{method}} {{uri}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "id": 3
    },
    {
      "type": "row",
      "title": "Traffic dan error",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
